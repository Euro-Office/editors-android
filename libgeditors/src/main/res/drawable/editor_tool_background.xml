<?xml version="1.0" encoding="utf-8"?>
<!-- Toolbar button: highlighted while its format is active (bold, alignment, ...).
     Colors, not theme attributes: theme attributes can't be resolved when the style loads this drawable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/editors_tool_selected" />
                <corners android:radius="10dp" />
            </shape>
        </inset>
    </item>
    <item android:state_pressed="true">
        <inset android:inset="4dp">
            <shape android:shape="rectangle">
                <solid android:color="@color/editors_tool_pressed" />
                <corners android:radius="10dp" />
            </shape>
        </inset>
    </item>
    <item android:drawable="@android:color/transparent" />
</selector>
