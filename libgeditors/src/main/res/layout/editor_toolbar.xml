<?xml version="1.0" encoding="utf-8"?>
<!-- Editing toolbar of all editors; buttons that don't apply are hidden -->
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorToolbar"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?android:attr/colorBackground"
    android:elevation="4dp"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp">

        <ImageButton android:id="@+id/toolEdit" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_edit" android:src="@drawable/ic_editor_edit"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolPages" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_pages" android:src="@drawable/ic_editor_pages"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolOutline" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_pages_contents" android:src="@drawable/ic_editor_outline"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolSign" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_sign" android:src="@drawable/ic_editor_sign"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolSearch" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_search" android:src="@drawable/ic_editor_search" />
        <ImageButton android:id="@+id/toolFile" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_file" android:src="@drawable/ic_editor_file"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolCoEditors" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_coediting_people" android:src="@drawable/ic_editor_people"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolComments" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_comments" android:src="@drawable/ic_editor_comment"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolSlideshow" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_slides_slideshow" android:src="@drawable/ic_editor_slideshow"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolSave" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_save" android:src="@drawable/ic_editor_save" />
        <ImageButton android:id="@+id/toolInsert" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_insert" android:src="@drawable/ic_editor_insert" />
        <ImageButton android:id="@+id/toolShape" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_shape" android:src="@drawable/ic_editor_shape"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolFormat" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_format" android:src="@drawable/ic_editor_format"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolDocument" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_doc_document" android:src="@drawable/ic_editor_document"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolTable" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_doc_table_menu" android:src="@drawable/ic_editor_table"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolAddSlide" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_add_slide" android:src="@drawable/ic_editor_slide_add"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolDeleteSlide" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_delete_slide" android:src="@drawable/ic_editor_slide_delete"
            android:visibility="gone" />
        <ImageButton android:id="@+id/toolBold" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_bold" android:src="@drawable/ic_editor_bold" />
        <ImageButton android:id="@+id/toolItalic" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_italic" android:src="@drawable/ic_editor_italic" />
        <ImageButton android:id="@+id/toolUnderline" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_underline" android:src="@drawable/ic_editor_underline" />
        <ImageButton android:id="@+id/toolAlignLeft" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_align_left" android:src="@drawable/ic_editor_align_left" />
        <ImageButton android:id="@+id/toolAlignCenter" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_align_center" android:src="@drawable/ic_editor_align_center" />
        <ImageButton android:id="@+id/toolAlignRight" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_align_right" android:src="@drawable/ic_editor_align_right" />
        <ImageButton android:id="@+id/toolUndo" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_undo" android:src="@drawable/ic_editor_undo" />
        <ImageButton android:id="@+id/toolRedo" style="@style/EditorToolButton"
            android:contentDescription="@string/editors_redo" android:src="@drawable/ic_editor_redo" />

    </LinearLayout>

</HorizontalScrollView>
