<?xml version="1.0" encoding="utf-8"?>
<!-- Spreadsheet editor: formula bar, sheet, sheet tabs and toolbar -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/editorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/formulaBar"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="?android:attr/colorBackground"
        android:elevation="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:id="@+id/cellName"
            android:layout_width="64dp"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/cellText"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/editors_cell_hint"
            android:imeOptions="actionDone|flagNoExtractUi"
            android:importantForAutofill="no"
            android:inputType="text"
            android:paddingHorizontal="8dp"
            android:singleLine="true" />

        <ImageButton
            android:id="@+id/cellConfirm"
            style="@style/EditorToolButton"
            android:contentDescription="@string/editors_cell_confirm"
            android:src="@drawable/ic_editor_check" />

    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <lib.editors.gbase.ui.views.SheetView
            android:id="@+id/sheetView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <ProgressBar
            android:id="@+id/documentProgress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />

    </FrameLayout>

    <HorizontalScrollView
        android:id="@+id/sheetTabsScroll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?android:attr/colorBackground"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/sheetTabs"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:orientation="horizontal"
            android:paddingHorizontal="4dp" />

    </HorizontalScrollView>

    <include layout="@layout/editor_toolbar" />

</LinearLayout>
